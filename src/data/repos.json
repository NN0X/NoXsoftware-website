    "code": "bool pqldpAntireplayCheck(const PqldpAntiReplayCtx_t *ctx, uint32_t seq)\n{\n        if (seq > ctx->topSeq)\n        {\n                return true;\n        }\n        uint32_t offset = ctx->topSeq - seq;\n        if (offset >= PQLDP_REPLAY_WINDOW_SIZE)\n        {\n                return false;\n        }\n        return (ctx->windowBitmap & (1ULL << offset)) == 0;"
   }
