---
import { PROJECTS, pathFor } from "../data/site";
import { translate } from "../lib/i18n";
import TopBar from "./TopBar.astro";
import Footer from "./Footer.astro";
---
<TopBar lang="en" path="/" />
<div class="notfound">403</div>
<p>{translate("en", "site.forbidden")} <span lang="pl">/ {translate("pl", "site.forbidden")}</span></p>
<img class="meme" src="/media/noooo.webp" alt={translate("en", "site.nooooAlt")} width="498" height="466" />
<p class="muted">{translate("en", "site.forbiddenSub")}</p>
<ul>
        {PROJECTS.map((p) => <li><a href={pathFor("en", "/projects/" + p.slug + "/")}>{p.name}</a></li>)}
</ul>
<Footer lang="en" />
