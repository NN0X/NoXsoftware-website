# Served by Apache2 on the Raspberry Pi, behind Cloudflare.

Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine on

# URLs from the old site keep working
RewriteRule ^html/projects(\.html)?$ /projects/ [R=301,L]
RewriteRule ^html/contact(\.html)?$ / [R=301,L]
RewriteRule ^html/proj/brutus(\.html)?$ /projects/brutus/ [R=301,L]
RewriteRule ^html/proj/cicero(\.html)?$ /projects/cicero/ [R=301,L]
RewriteRule ^html/proj/f1ratings(\.html)?$ /projects/f1ratings/ [R=301,L]

# Easter eggs from the old site (pages arrive with the media in a later phase)
RewriteRule ^c/?$ /eggs/c/ [R=301,L]
RewriteRule ^c\+\+isthebest/?$ /eggs/cpp/ [R=301,L]
RewriteRule ^linux\>windowsallday/?$ /eggs/linux/ [R=301,L]
RewriteRule ^pythonistoobadforbeingthisuseful/?$ /eggs/python/ [R=301,L]

<IfModule mod_headers.c>
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        # Astro fingerprints everything under /_astro/, so it can be cached forever
        <If "%{REQUEST_URI} =~ m#^/_astro/#">
                Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
        <If "%{REQUEST_URI} =~ m#(\.html|/)$#">
                Header set Cache-Control "no-cache"
        </If>
</IfModule>
